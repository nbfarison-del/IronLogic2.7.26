rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/data)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/data).data.role == 'admin';
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAssignedCoach(userId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(userId)/profile/data)
        && get(/databases/$(database)/documents/users/$(userId)/profile/data).data.coach_id == request.auth.uid;
    }

    function canReadUser(userId) {
      return ownsUserDoc(userId) || isAssignedCoach(userId) || isAdmin();
    }

    function canWriteUser(userId) {
      return ownsUserDoc(userId) || isAdmin();
    }

    function canCoachWrite(userId) {
      return isAssignedCoach(userId);
    }

    function isAdminRoleRequest() {
      return request.resource.data.keys().hasAny(['role']);
    }

    // Admin and owner have full write access to all subcollections
    // Coaches have read access but write access only to specific subcollections
    match /users/{userId}/{document=**} {
      allow read: if canReadUser(userId);
      allow write: if canWriteUser(userId) && !(isAdminRoleRequest() && !isAdmin() && ownsUserDoc(userId));
    }

    // Coach write access to specific subcollections needed for their role
    match /users/{userId}/athletePrograms/{document=**} {
      allow write: if canCoachWrite(userId);
    }
    match /users/{userId}/coaching/{document=**} {
      allow write: if canCoachWrite(userId);
    }
    match /users/{userId}/programCompliance/{document=**} {
      allow write: if canCoachWrite(userId);
    }
    match /users/{userId}/workouts/{workoutId}/comments/{document=**} {
      allow write: if canCoachWrite(userId);
    }
    match /users/{userId}/ilm/{document=**} {
      allow write: if canCoachWrite(userId);
    }

    match /registered_users/{userId} {
      allow read: if ownsUserDoc(userId) || isAdmin();
      allow create: if ownsUserDoc(userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /program_templates/{templateId} {
      allow read: if signedIn() && (resource.data.visibility == 'public' || resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if signedIn();
      allow update, delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }
  }
}

